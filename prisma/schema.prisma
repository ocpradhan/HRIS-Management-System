// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(EMPLOYEE)
  employee  Employee?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Employee {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 1. Department Relationship
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // 2. Job Title Relationship
  jobTitleId String?
  jobTitle   JobTitle? @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)

  // 3. Self-Referential Hierarchy (Manager <-> Reports)
  managerId String?
  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("ManagerReports")

  leaveRequests         LeaveRequest[] @relation("EmployeeLeaveRequests")
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveReviewer")

  // 4. Attendance Relationship
  attendanceRecords Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 5. Peformance Review Relationship
  performanceReviews PerformanceReview[] @relation("EmployeeReviews")
  givenReviews       PerformanceReview[] @relation("ReviewerReviews")

  @@map("employees")
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  employees   Employee[] // One-to-many: a department has many employees
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model JobTitle {
  id          String     @id @default(uuid())
  title       String     @unique
  salaryGrade String?
  employees   Employee[] // One-to-many: a job title belongs to many employees
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String
  // Relation name "EmployeeLeaveRequests"
  employee   Employee @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(PENDING)

  // Who reviewed this request (Manager or HR)
  reviewedById String?
  // Named relation matching "LeaveReviewer" in Employee Model
  reviewedBy   Employee? @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leave_requests")
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  clockIn    DateTime
  clockOut   DateTime?
  workHours  Float?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
}

enum ReviewPeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
  PROBATION
}

model PerformanceReview {
  id           String       @id @default(uuid())
  employeeId   String
  employee     Employee     @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     Employee     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  period       ReviewPeriod
  year         Int
  rating       Int
  strengths    String?
  improvements String?
  comments     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, period, year])
}
